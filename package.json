{
  "name": "tracenotes",
  "displayName": "TraceNotes",
  "description": "An extension for code tracing and note-taking.",
  "version": "0.0.67",
  "publisher": "RobertttBS",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertttBS/vscode-tracenotes.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "TraceNotes",
      "properties": {
        "tracenotes.projectId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Folders with the same project ID share their traces. Leave empty to use the git origin URL, or the folder name when there is none. Use the TraceNotes: Set Project ID command to switch immediately; after editing it by hand, reload the window."
        },
        "tracenotes.minimap.cardWidth": {
          "type": "number",
          "default": 380,
          "minimum": 200,
          "maximum": 1000,
          "description": "Width (px) of each card in the minimap."
        },
        "tracenotes.minimap.columnGap": {
          "type": "number",
          "default": 60,
          "minimum": 56,
          "maximum": 400,
          "description": "Horizontal gap (px) between depth columns in the minimap (min 56, so the active-card arrow fits in the gap). Each child level starts one card width plus this gap to the right of its parent."
        }
      }
    },
    "commands": [
      {
        "command": "tracenotes.collectTrace",
        "title": "TraceNotes: Collect Trace"
      },
      {
        "command": "tracenotes.exportMarkdown",
        "title": "TraceNotes: Export to Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "tracenotes.importTrace",
        "title": "TraceNotes: Import Trace"
      },
      {
        "command": "tracenotes.clearAll",
        "title": "TraceNotes: Clear All Traces"
      },
      {
        "command": "tracenotes.exportData",
        "title": "TraceNotes: Export All Data to JSON"
      },
      {
        "command": "tracenotes.jumpToFadedTrace",
        "title": "Jump to Trace Card (Faded Decoration)"
      },
      {
        "command": "tracenotes.setProjectId",
        "title": "TraceNotes: Set Project ID",
        "icon": "$(link)"
      },
      {
        "command": "tracenotes.setupAgents",
        "title": "TraceNotes: Set Up AI Agents"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tracenotes-sidebar",
          "title": "TraceNotes",
          "icon": "$(bookmark)"
        }
      ]
    },
    "views": {
      "tracenotes-sidebar": [
        {
          "type": "webview",
          "id": "tracenotes.storyboard",
          "name": "Storyboard"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tracenotes.collectTrace",
        "key": "alt+c",
        "mac": "alt+c",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tracenotes.exportMarkdown",
          "when": "view == tracenotes.storyboard",
          "group": "navigation@1"
        },
        {
          "command": "tracenotes.setProjectId",
          "when": "view == tracenotes.storyboard",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
